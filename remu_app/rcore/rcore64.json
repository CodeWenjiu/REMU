{
    "arch": "riscv64",
    "atomic-cas": false,
    "code-model": "medium",
    "cpu": "generic-rv64",
    "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
    "executables": true,
    "features": "+m,+forced-atomics",
    "linker": "rust-lld",
    "linker-flavor": "gnu-lld",
    "llvm-abiname": "lp64",
    "llvm-target": "riscv64",
    "max-atomic-width": 64,
    "os": "rcore",
    "panic-strategy": "abort",
    "relocation-model": "static",
    "target-pointer-width": 64,
    "vendor": "unknown"
}