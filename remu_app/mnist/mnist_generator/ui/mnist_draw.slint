// MNIST digit capture: a 28x28 paint grid plus label/brush controls.
//
// The Rust side owns the pixels and the file formats (`src/main.rs`); this file
// only renders the grid and reports pointer input. Positions cross the boundary
// in logical pixels, so the cell mapping lives in Rust alongside its tests.

import { Button, Palette, Slider, SpinBox } from "std-widgets.slint";

export component MnistDraw inherits Window {
    title: "MNIST digit capture";
    width: 620px;
    height: 780px;
    background: #15171b;
    default-font-family: "DejaVu Sans";

    // Pin the dark color scheme so the std-widgets match the window.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // 784 gray levels (0..255), row-major: pixel(row, col) = pixels[row * 28 + col].
    in property <[int]> pixels;
    in-out property <int> label: 0;
    // Brush radius in cells; fractional values stamp a partially covered disc edge.
    in-out property <float> brush-radius: 1;
    in-out property <string> status: "Left button draws, right button erases.";

    // Canvas geometry; the Rust side reads this to map pointer positions.
    out property <length> cell-size: 18px;

    // Canvas-relative pointer position in logical pixels, plus whether to paint
    // (true) or erase (false).
    callback paint(float, float, bool);
    // Pointer released: the next `paint` starts a new stroke.
    callback stroke-end();
    callback clear-canvas();
    callback save-image();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "MNIST digit capture";
            font-size: 21px;
            font-weight: 700;
            color: #eef1f5;
        }
        Text {
            text: "Draw a digit on the 28x28 canvas, pick its label, then save it into remu_app/mnist/test_images/.";
            font-size: 13px;
            color: #98a1ac;
            wrap: word-wrap;
        }

        // Controls.
        Rectangle {
            border-radius: 10px;
            background: #1e2126;
            border-width: 1px;
            border-color: #2b3038;

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                Text {
                    text: "Label";
                    font-size: 13px;
                    color: #c8cdd4;
                    vertical-alignment: center;
                }
                SpinBox {
                    value <=> root.label;
                    minimum: 0;
                    maximum: 9;
                    width: 92px;
                }
                Text {
                    text: "Brush";
                    font-size: 13px;
                    color: #c8cdd4;
                    vertical-alignment: center;
                }
                Slider {
                    value <=> root.brush-radius;
                    minimum: 0;
                    maximum: 3;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "\{(root.brush-radius).to-fixed(1)}";
                    font-size: 13px;
                    color: #c8cdd4;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 28px;
                }
                Button {
                    text: "Clear canvas";
                    clicked => { root.clear-canvas(); }
                }
                Button {
                    text: "Save sample";
                    primary: true;
                    clicked => { root.save-image(); }
                }
            }
        }

        Text {
            text: root.status;
            font-size: 13px;
            color: #60cdff;
            wrap: word-wrap;
            // Reserved height keeps the canvas from jumping when a save message appears.
            min-height: 34px;
            vertical-alignment: top;
        }

        // Canvas: a dark card whose cells are inset by the grid gap, so the
        // outermost margin matches the grid lines. Uniform 2px gaps stay crisp
        // even when the canvas lands on a fractional pixel offset.
        HorizontalLayout {
            alignment: center;
            vertical-stretch: 1;

            Rectangle {
                width: root.cell-size * 28 + 4px;
                height: root.cell-size * 28 + 4px;
                background: #262a33;
                border-radius: 10px;
                drop-shadow-color: #000000a6;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 4px;

                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: root.cell-size * 28;
                    height: root.cell-size * 28;
                    clip: true;

                    // Slint's `/` on integers is a float division, so the row
                    // needs the floor: otherwise every column lands at a
                    // fractionally different y and the grid comes out sheared.
                    for i in 784 : Rectangle {
                        x: root.cell-size * Math.mod(i, 28);
                        y: root.cell-size * Math.floor(i / 28);
                        width: root.cell-size - 2px;
                        height: root.cell-size - 2px;
                        background: rgba(root.pixels[i], root.pixels[i], root.pixels[i], 1.0);
                    }

                    // Painting. The pointer-event payload carries the button and
                    // the kind only; the position comes from mouse-x / mouse-y.
                    touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;

                        // 0 = idle, 1 = painting, 2 = erasing.
                        property <int> stroke: 0;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.left) {
                                    touch.stroke = 1;
                                } else if (event.button == PointerEventButton.right) {
                                    touch.stroke = 2;
                                } else {
                                    touch.stroke = 0;
                                }
                                touch.paint-at-cursor();
                            } else if (event.kind == PointerEventKind.move) {
                                if (touch.stroke != 0) {
                                    touch.paint-at-cursor();
                                }
                            } else {
                                // up / cancel
                                touch.stroke = 0;
                                root.stroke-end();
                            }
                        }

                        function paint-at-cursor() {
                            root.paint(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                                touch.stroke == 1);
                        }
                    }

                    // Brush preview: the disc the next stamp covers. The Rust side
                    // paints every cell whose center the disc reaches.
                    if touch.has-hover : Rectangle {
                        width: root.cell-size * (2 * root.brush-radius + 1);
                        height: root.cell-size * (2 * root.brush-radius + 1);
                        border-radius: self.width / 2;
                        border-width: 1px;
                        border-color: #ffffffcc;
                        x: touch.mouse-x - self.width / 2;
                        y: touch.mouse-y - self.height / 2;
                    }
                }
            }
        }

        Text {
            text: "Drag to draw; the right button erases. The saved .txt/.bin pair is embedded by the mnist app on its next build.";
            font-size: 12px;
            color: #79828d;
            wrap: word-wrap;
        }
    }
}
