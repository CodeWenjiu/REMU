<!-- Composed by xtask into target/app_model/<app>.xml from the app's
     [package.metadata.remu] arm-model (the included scene) and that model's
     assets directory (the meshdir); the placeholders in the two attributes
     below are substituted before use.
     The compiler must follow the include: the included scene's own compiler
     (meshdir, angle, autolimits) is not honored. -->
<mujoco model="panda remu demo">
  <include file="@SCENE@"/>
  <compiler angle="radian" autolimits="true" meshdir="@MESH@"/>
  <worldbody>
    <geom name="obstacle:pole" type="capsule" fromto="0.476 0.275 0.0 0.476 0.275 0.9" size="0.035" rgba="0.75 0.25 0.2 1" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>